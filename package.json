{
	"name": "felix-kramer-com",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run --config vitest.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
